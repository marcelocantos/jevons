<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- T779: ProcessType Interactive keeps supervisord children at user-interactive priority. -->
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>homebrew.mxcl.supervisor</string>
	<key>LimitLoadToSessionType</key>
	<array>
		<string>Aqua</string>
		<string>Background</string>
		<string>LoginWindow</string>
		<string>StandardIO</string>
		<string>System</string>
	</array>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/opt/supervisor/bin/supervisord</string>
		<string>-c</string>
		<string>/opt/homebrew/etc/supervisord.conf</string>
		<string>--nodaemon</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
