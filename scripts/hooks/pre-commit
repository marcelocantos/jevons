#!/usr/bin/env bash
# Shared-index commit guard (🎯T377) + shared-file write sweep (🎯T391).
#
# Thin wrapper only: it locates the policy binaries and runs them. All
# decisions live in Go packages, because those decisions deserve tests.
#
#   commitscope  — refuses bare/sweeping `git commit` forms (🎯T377)
#                  and warns when --only bullseye.yaml would land
#                  another worker's target rows (🎯T748)
#   treeguard sweep — reports guarded-file losses that never passed the
#                     write guard (🎯T391). Provider-independent: every
#                     harness that can commit reaches this boundary, so a
#                     grok/claudia worker that inherits no PreToolUse hook
#                     still gets a loud detect rather than a silent loss.
#
# Exit status contract (commitscope owns refusal):
#   0  allow    1  guard broken (visible, not a silent pass)    2  refused
#
# Sweep never refuses: a loss it reports has already landed, and exiting
# non-zero here would punish whoever is committing rather than whoever
# clobbered. A missing treeguard binary is loud on stderr and non-blocking
# for the same reason the Claude hook treats exit 1 as non-blocking — a
# pre-commit exit 1 would block every commit in a clean clone mid-build.
#
# 🎯T960: both binaries are self-healed — rebuilt automatically when missing
# OR older than the newest commit touching their source — so neither guard
# can sit stale and silently enforce old rules; a rebuild that fails prints a
# loud, specific stderr line instead.
#
# guard_ensure_fresh is inlined (not sourced from a shared lib) on purpose:
# this file is installed/copied standalone (commitscope --install into
# .git/hooks, hook test fixtures) with no sibling directory alongside it, so
# a `source lib/...` would work in the repo and break silently everywhere
# it's copied to.
set -uo pipefail

root="${CLAUDE_PROJECT_DIR:-}"
if [[ -z "$root" ]]; then
    root="$(cd "$(dirname "$0")/../.." && pwd)"
fi

guard_ensure_fresh() {
    local root="$1" bin="$2" pkg="$3"
    shift 3
    local src_paths=("$@")

    local newest_epoch="" newest_sha=""
    if [[ ${#src_paths[@]} -gt 0 ]]; then
        local line
        line="$(cd "$root" 2>/dev/null && git log -1 --format='%ct %h' -- "${src_paths[@]}" 2>/dev/null)"
        if [[ -n "$line" ]]; then
            newest_epoch="${line%% *}"
            newest_sha="${line#* }"
        fi
    fi

    local need_build=0
    if [[ ! -x "$bin" ]]; then
        need_build=1
    elif [[ -n "$newest_epoch" ]]; then
        local bin_mtime
        bin_mtime="$(stat -f %m "$bin" 2>/dev/null || stat -c %Y "$bin" 2>/dev/null)"
        if [[ -n "$bin_mtime" && "$bin_mtime" -lt "$newest_epoch" ]]; then
            need_build=1
        fi
    fi

    if [[ "$need_build" -eq 0 ]]; then
        return 0
    fi

    if (cd "$root" && go build -o "$bin" "$pkg") 2>/dev/null; then
        return 0
    fi

    if [[ -x "$bin" && -n "$newest_sha" ]]; then
        local build_time
        build_time="$(stat -f '%Sm' -t '%Y-%m-%d %H:%M:%S' "$bin" 2>/dev/null)"
        if [[ -z "$build_time" ]]; then
            local epoch
            epoch="$(stat -c %Y "$bin" 2>/dev/null)"
            if [[ -n "$epoch" ]]; then
                build_time="$(date -d "@$epoch" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"
            fi
        fi
        printf '%s: %s is STALE (built %s, older than commit %s touching its source) and rebuild failed — run: go build -o %s %s\n' \
            "$(basename "$bin")" "$bin" "${build_time:-an unknown time}" "$newest_sha" "$bin" "$pkg" >&2
    else
        printf '%s: %s missing and `go build %s` failed — guard INACTIVE.\n' \
            "$(basename "$bin")" "$bin" "$pkg" >&2
    fi
    return 1
}

# Tests point this at a prebuilt binary so they exercise this shim rather than
# a copy of it.
bin="${JEVONS_COMMITSCOPE_BIN:-$root/bin/commitscope}"

if ! guard_ensure_fresh "$root" "$bin" ./cmd/commitscope internal/commitscope cmd/commitscope; then
    exit 1
fi

# Do not exec: the treeguard sweep below must still run on an allow.
"$bin" "$@"
rc=$?
if [[ "$rc" -ne 0 ]]; then
    exit "$rc"
fi

# 🎯T391 provider-independent half. Best-effort and never blocks the commit.
tg="${JEVONS_TREEGUARD_BIN:-$root/bin/treeguard}"
if ! guard_ensure_fresh "$root" "$tg" ./cmd/treeguard internal/treeguard cmd/treeguard; then
    exit 0
fi

# Sweep prints its own findings (and the unprotected-provider notice) on
# stderr; its non-zero is a tooling failure, never a refusal — keep the
# commit allow from commitscope either way.
"$tg" sweep >/dev/null || printf 'treeguard: sweep exited %s — write-guard detect path failed open (🎯T391)\n' "$?" >&2
exit 0
