<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="bottom|center_horizontal">
    <!-- Gutter, track, chevron rail. The gutter is as wide as the rail, so the
         track is the centre of the slot: the chevron is too small to count as
         part of the bar's shape when the column centres it under the logo. -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <FrameLayout android:layout_width="5dp" android:layout_height="1dp" />
        <FrameLayout android:id="@+id/bar_track" android:layout_width="12dp"
            android:layout_height="72dp" android:background="@drawable/usage_track">
            <FrameLayout android:id="@+id/bar_fill" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_gravity="bottom" android:background="#a0a0a0" />
        </FrameLayout>
        <!-- The chevron's rail: as tall as the track, the chevron raised by a bottom margin. -->
        <FrameLayout android:id="@+id/chevron_rail" android:layout_width="5dp" android:layout_height="72dp">
            <ImageView android:id="@+id/chevron" android:layout_width="5dp" android:layout_height="6dp"
                android:layout_gravity="bottom" android:src="@drawable/usage_chevron"
                android:contentDescription="@null" />
        </FrameLayout>
    </LinearLayout>
    <!-- Centred under the symmetric slot, which is centred on the track. -->
    <TextView android:id="@+id/window_letter" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textColor="#eeeeee"
        android:textSize="11sp" android:textStyle="bold" />
</LinearLayout>
